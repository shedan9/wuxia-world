; Engine configuration file.
; 目标：Godot 4.7.2 .NET，仅 Windows x64（架构文档 4.2）。

config_version=5

[application]

config/name="武侠世界"
config/description="高清 2D 单机武侠回合制 RPG — M0 视觉 Demo"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "C#")

[autoload]

AppHost="*res://scripts/presentation/App/AppHost.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="WuxiaWorld.Game"
project/solution_directory=".."

[internationalization]

; 导出包带上文本服务器的断行数据（ICU 断行规则与中文词典）；不带时导出包里的中文只能在空格处折行，
; 长句整句挤不下就把行首序号单独留在一行或越出边框（编辑器自带这份数据，所以只在导出包里出现）。
locale/include_text_server_data=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=2
