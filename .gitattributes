* text=auto eol=lf
*.cs text eol=lf
*.ps1 text eol=crlf
*.sln text eol=crlf

# 分层源文件与音频母带（架构文档 4.2 / 10.5）
art_source/** filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.clip filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text

# 运行时高清纹理与字体
game/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.ttf filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.otf filter=lfs diff=lfs merge=lfs -text

# 保留 .gitkeep 为普通文件
**/.gitkeep !filter !diff !merge text
art_source/**/*.md !filter !diff !merge text

# 旧档回归样本：校验和按原始字节计算，不做换行转换
tests/Fixtures/saves/*.json -text
