<Project Sdk="Microsoft.NET.Sdk">
  <!-- 内容编译：校验 content/ 并生成 game/generated/content（架构文档 9.3）。M1 只编译战斗内容，M2 起扩到地图、任务与对白。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WuxiaWorld.Tools.ContentCompiler</RootNamespace>
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\WuxiaWorld.Infrastructure\WuxiaWorld.Infrastructure.csproj" />
  </ItemGroup>
</Project>
